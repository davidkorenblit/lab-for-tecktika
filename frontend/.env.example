# Base URL for the backend API.
# Leave empty when the SPA and the API are served from the same Static Web App
# (the default): requests then go to the same origin, e.g. /api/chat/history.
VITE_API_BASE_URL=

# Entra ID (Azure AD) app registration used for MSAL.js sign-in (public
# client, PKCE, no secret). Not sensitive — safe to commit real values, same
# as infrastructure/main.bicepparam's entraTenantId/entraApiClientId, which
# these must match. One app registration serves both roles: SPA client and
# the API resource whose scope is requested. See
# infrastructure/scripts/register-entra-app.sh.
VITE_MSAL_CLIENT_ID=7267f8e7-50eb-4247-88b7-da2cc3adf6f6
VITE_MSAL_TENANT_ID=6fc8a795-8bcb-4e52-8b36-41c1971e6816
VITE_MSAL_API_SCOPE=api://7267f8e7-50eb-4247-88b7-da2cc3adf6f6/access_as_user

# Dev-only: vite proxies /api here so `npm run dev` can talk to a locally
# running backend (uvicorn, default port 8000) or a deployed environment.
VITE_DEV_API_PROXY=http://localhost:8000

# Bypass MSAL sign-in during local development (no Entra ID redirect flow).
# Any value other than "true" is ignored.
VITE_AUTH_DEV_BYPASS=false

# Optional static token used only when VITE_AUTH_DEV_BYPASS=true.
VITE_AUTH_DEV_TOKEN=

# Block size (bytes) used when uploading large PDFs to Azure Blob Storage.
VITE_UPLOAD_BLOCK_SIZE=8388608
