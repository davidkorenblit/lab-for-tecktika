# Base URL for the backend API.
# Leave empty when the SPA and the API are served from the same Static Web App
# (the default): requests then go to the same origin, e.g. /api/chat/history.
VITE_API_BASE_URL=

# Where /.auth/me is served from. Only override this if Easy Auth lives on a
# different host than the SPA.
VITE_AUTH_BASE_URL=

# Dev-only: vite proxies /api and /.auth here so `npm run dev` can talk to a
# locally running Functions host or a deployed environment.
VITE_DEV_API_PROXY=http://localhost:7071

# Bypass Easy Auth during local development (no /.auth/me available).
# Any value other than "true" is ignored.
VITE_AUTH_DEV_BYPASS=false

# Optional static token used only when VITE_AUTH_DEV_BYPASS=true.
VITE_AUTH_DEV_TOKEN=

# Block size (bytes) used when uploading large PDFs to Azure Blob Storage.
VITE_UPLOAD_BLOCK_SIZE=8388608
